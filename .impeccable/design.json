      "html": "<div class=\"ds-search\"><input aria-label=\"Buscar prácticas\" placeholder=\"¿Qué estás estudiando?\"/><button>Buscar</button></div>",
      "css": ".ds-search{font-family:var(--font-text,\"Urbanist Variable\",sans-serif);display:flex;align-items:center;gap:14px;border:1px solid var(--border,#dce3da);border-radius:14px;padding:8px 9px 8px 20px;background:var(--card,#fff)}.ds-search input{flex:1;width:0;min-height:44px;min-width:0;border:0;outline:none;background:transparent;color:var(--foreground,#192c25);font:inherit}.ds-search input::placeholder{color:var(--muted-foreground,#5b6860)}.ds-search:focus-within{outline:2px solid var(--ring,#387655);outline-offset:3px}.ds-search button{border:0;border-radius:9px;min-height:46px;padding:11px 18px;background:var(--primary,#204c3c);color:var(--primary-foreground,#fff);font:inherit;font-size:14px;font-weight:650;cursor:pointer}.ds-search button:hover{filter:brightness(.93)}.ds-search button:active{transform:translateY(1px)}.ds-search button:focus-visible{outline:3px solid var(--ring,#387655);outline-offset:4px}"
