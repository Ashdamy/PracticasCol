      "css": ".ds-nav{font-family:var(--font-text,\"Urbanist Variable\",sans-serif);display:flex;align-items:center;flex-wrap:wrap;gap:28px;color:var(--foreground,#192c25);font-size:14px;font-weight:600}.ds-nav a{position:relative;display:flex;align-items:center;min-height:44px;color:inherit;text-decoration:none}.ds-nav a:not(.ds-profile)::after{content:\"\";position:absolute;bottom:5px;height:2px;left:0;right:0;background:var(--primary,#204c3c);transform:scaleX(0);transform-origin:left;transition:transform .2s}.ds-nav a:hover::after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:3px solid var(--ring,#387655);outline-offset:4px}.ds-nav .ds-profile{border:1px solid var(--border,#dce3da);border-radius:30px;padding:0 16px;background:var(--card,#fff)}@media(prefers-reduced-motion:reduce){.ds-nav a::after{transition:none}}"
