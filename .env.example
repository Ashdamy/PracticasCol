# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repo.

# true = usa los datos de prueba de src/lib/mocks (Fase 0). false = usa Supabase (Fase 1+).
USE_MOCKS=true

# Supabase (Fase 1). Las claves públicas pueden ir al navegador; la service role NO.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
