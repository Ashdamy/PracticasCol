# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repo.

# true = usa los datos de prueba de src/lib/mocks (Fase 0). false = usa Supabase (Fase 1+).
USE_MOCKS=true

# URL pública del sitio, con protocolo y sin "/" final (p. ej. https://practicascol.vercel.app).
# Se usa como metadataBase para que las imágenes Open Graph apunten al dominio real.
# Configúrala al compilar o desplegar. Si falta, se usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Ingesta (opcional): URL de contacto que se añade al User-Agent del bot, p. ej. una página del proyecto.
# Si falta, el bot se identifica solo como "PracticasColBot/0.1".
INGESTION_CONTACT_URL=

# Logos de empresas (Brandfetch Logo API). Client ID PÚBLICO por diseño: va en cada URL de logo que carga el navegador.
# Si falta, no hay logos de Brandfetch y la interfaz muestra las iniciales de la empresa.
# Brandfetch exige hotlinking: las URLs se usan directo en <img>; no se descargan ni se guardan copias (no usar next/image).
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# Supabase (Fase 1). Se usan cuando USE_MOCKS=false, y siempre en `npm run ingest -- --store=supabase` y `npm run admin`.
# La URL y la clave publicable pueden ir al navegador. La clave secreta (sb_secret_… o service_role) NO:
# omite RLS, solo la lee el servidor y nunca debe llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
